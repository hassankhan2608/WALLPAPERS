{
  // ================================================================
  // 🛠️ Performance & Formatting Settings
  // ================================================================

  // Executes code actions (like lint auto-fixes) on save.
  // "source.fixAll" will fix all fixable issues when explicitly triggered.
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // Automatically formats the document on save.
  // Options: true | false
  "editor.formatOnSave": true,

  // Automatically formats the pasted content.
  "editor.formatOnPaste": true,

  // Number of spaces a tab represents. Commonly 2 for JavaScript projects.
  "editor.tabSize": 2,

  // Removes any trailing whitespace at the end of lines on save.
  "files.trimTrailingWhitespace": true,

  // Ensures that a file always ends with a newline.
  "files.insertFinalNewline": true,

  // Controls auto save behavior.
  // Options:
  //   "off"             → No auto save.
  //   "afterDelay"      → Saves after a short delay.
  //   "onFocusChange"   → Saves when focus moves out of the editor.
  //   "onWindowChange"  → Saves when switching windows.
  "files.autoSave": "afterDelay",

  // ================================================================
  // 🎨 Editor Appearance Settings
  // ================================================================

  // Enables/disables the minimap (a small overview of your code on the right).
  // Options: true | false
  "editor.minimap.enabled": false,

  // Controls when whitespace characters are rendered.
  // Options:
  //   "none"       → Never show.
  //   "boundary"   → Only show for selected boundaries.
  //   "selection"  → Only show when text is selected.
  //   "all"        → Always show.
  "editor.renderWhitespace": "selection",

  // Controls the highlighting of the current line.
  // Options:
  //   "none"   → No highlighting.
  //   "gutter" → Highlight in the gutter.
  //   "all"    → Highlight both the gutter and the line.
  "editor.renderLineHighlight": "all",

  // Removes the border around the overview ruler (mini scrollbar).
  "editor.overviewRulerBorder": false,

  // Hides the cursor indicator in the overview ruler.
  "editor.hideCursorInOverviewRuler": true,

  // Enables/disables code folding (collapsing/expanding code blocks).
  "editor.folding": true,

  // Disables highlighting of all occurrences of a selected symbol.
  // Options: "on" | "off"
  "editor.occurrencesHighlight": "off",

  // Always highlights matching brackets to improve code readability.
  // Options: "never" | "near" | "allalways"
  "editor.matchBrackets": "always",

  // Hides the glyph margin used for breakpoints and line decorations.
  "editor.glyphMargin": false,

  // ================================================================
  // 🔤 Font & Cursor Customization
  // ================================================================

  // Sets the font family with fallbacks.
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', 'Fira Code', 'Courier New', monospace",

  // Sets the font size in pixels.
  "editor.fontSize": 15,

  // Enables font ligatures if your font supports them.
  "editor.fontLigatures": true,

  // Enables advanced font variations.
  "editor.fontVariations": true,

  // Controls the cursor blinking style.
  // Options:
  //   "blink"  → Regular blinking.
  //   "smooth" → Smooth fading in/out.
  //   "phase"  → Fading animation.
  //   "expand" → Expanding cursor.
  //   "solid"  → No blinking.
  "editor.cursorBlinking": "phase",

  // Enables smooth caret movement.
  // Options: "on" | "off"
  "editor.cursorSmoothCaretAnimation": "on",

  // Sets the line height (in pixels) for readability.
  "editor.lineHeight": 26,

  // Shows line numbers in the editor.
  // Options:
  //   "on"       → Always show.
  //   "off"      → Never show.
  //   "relative" → Show relative line numbers.
  //   "interval" → Show at fixed intervals.
  "editor.lineNumbers": "on",

  // Enables smooth scrolling for a better experience.
  "editor.smoothScrolling": true,

  // ================================================================
  // 🔲 Bracket & Code Navigation
  // ================================================================

  // Provides independent colors for different types of brackets.
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,

  // Disables guides that visually connect bracket pairs.
  // Options: true | false
  "editor.guides.bracketPairs": true,

  // Disables the breadcrumb navigation bar at the top.
  "breadcrumbs.enabled": false,

  // ================================================================
  // 🗂️ File & Tab Management
  // ================================================================

  // Limits the number of open tabs per editor group to reduce clutter.
  "workbench.editor.limit.enabled": true,

  // Maximum number of open tabs per editor group.
  "workbench.editor.limit.perEditorGroup": true,

  // Controls how many open editors are visible in the Explorer's Open Editors section.
  "explorer.openEditors.visible": 5,

  // Disables preview mode so files open fully rather than in a temporary preview.
  "workbench.editor.enablePreview": false,

  // ================================================================
  // ⌨️ Terminal Customization
  // ================================================================

  // Enables smooth scrolling in the integrated terminal.
  "terminal.integrated.smoothScrolling": true,

  // Enables a blinking cursor in the terminal.
  "terminal.integrated.cursorBlinking": true,

  // ================================================================
  // 🔍 File Exclusions & Search Optimization
  // ================================================================

  // Excludes specific folders from the global search results.
  // The "**" is a glob pattern to match the folder in any directory.
  "search.exclude": {
    "**/node_modules": true,
    "build": true,
    ".next": true,
    "dist": true
  },

  // Hides specific files or folders from the Explorer.
  "files.exclude": {
    "**/node_modules": true,
    "**/.node_modules": true,
    "**/.vscode": true
  },

  // ================================================================
  // 🎭 UI & Theme Customizations
  // ================================================================

  // Hides the status bar at the bottom.
  "workbench.statusBar.visible": false,

  // Disables file badges (small indicators) in the editor tabs.
  "workbench.editor.decorations.badges": false,

  // Disables color decorations in the editor tabs.
  "workbench.editor.decorations.colors": false,

  // Hides layout control buttons (e.g., split editor).
  "workbench.layoutControl.enabled": false,

  // Controls the visibility of the menu bar.
  // Options:
  //   "classic" → Always visible.
  //   "visible" → Always visible.
  //   "toggle"  → Hidden by default; appears on Alt key press.
  //   "hidden"  → Permanently hidden.
  "window.menuBarVisibility": "toggle",

  // Customizes the window title.
  // "${dirty}" shows an indicator if there are unsaved changes.
  // "${activeEditorShort}" displays the active file name.
  "window.title": "${dirty}${activeEditorShort}",

  // Sets the title bar style.
  // Options:
  //   "native" → Uses the operating system's native title bar.
  //   "custom" → Uses VS Code's custom title bar, which can be further styled.
  "window.titleBarStyle": "native",

  // Sets the file icon theme.
  // Alternatives: "vs-seti", "minimal", etc.
  "workbench.iconTheme": "vs-nomo-dark",

  // Sets the product icon theme (affects certain UI icons).
  "workbench.productIconTheme": "icons-carbon",

  // Controls the position of the tab close button.
  // Options: "left", "right", "off"
  "workbench.editor.tabCloseButton": "right",

  // Sets the location for additional tab action buttons (like split editor).
  // Options: "left", "right"
  "workbench.editor.tabActionLocation": "right",

  // ================================================================
  // 🔧 Prettier & Formatting Customizations
  // ================================================================

  // Prettier is a popular code formatter.
  // Enforces the use of double quotes instead of single quotes.
  "prettier.singleQuote": false,

  // Ensures object properties are quoted only when necessary.
  "prettier.quoteProps": "consistent",

  // Enforces the use of double quotes in JSX.
  "prettier.jsxSingleQuote": false,

  // Adds trailing commas where valid (e.g., in objects and arrays).
  // Options:
  //   "none" → No trailing commas.
  //   "es5"  → Trailing commas where valid in ES5 (objects, arrays, etc.).
  //   "all"  → Trailing commas in all possible cases.
  "prettier.trailingComma": "es5",

  // Enforces the use of semicolons.
  "prettier.semi": true,

  // Sets the maximum line length before wrapping.
  "prettier.printWidth": 80,

  // Controls the use of parentheses in arrow functions.
  // Options:
  //   "avoid"  → Omit parentheses for a single parameter.
  //   "always" → Always include parentheses.
  "prettier.arrowParens": "avoid",

  // ================================================================
  // 🔧 JavaScript/TypeScript & Auto Import Settings
  // ================================================================

  // Automatically updates import paths when files are moved or renamed.
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  // ================================================================
  // ⚡ Emmet & IntelliSense
  // ================================================================

  // Expands Emmet abbreviations when the Tab key is pressed.
  "emmet.triggerExpansionOnTab": true,

  // Enables inline suggestions while you type.
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },

  // Displays parameter hints (function signatures) as you type.
  "editor.parameterHints.enabled": true,

  // Controls how snippet suggestions are displayed in the IntelliSense list.
  // Options: "top", "bottom", "inline", "none"
  "editor.snippetSuggestions": "top",

  // Automatically inserts a closing bracket when you type an opening one.
  "editor.autoClosingBrackets": "always",

  // Automatically inserts a closing quote when you type an opening one.
  "editor.autoClosingQuotes": "always",

  // Automatically surrounds selected text with quotes or brackets, based on language rules.
  // Options: "languageDefined", "quotes", "brackets", "never"
  "editor.autoSurround": "languageDefined",

  // ================================================================
  // 🔧 Git & Source Control
  // ================================================================

  // Disables confirmation before syncing changes.
  "git.confirmSync": false,

  // Enables smart commit functionality (committing changes without manually staging them).
  "git.enableSmartCommit": true,

  // ================================================================
  // 🔧 GitHub Copilot Settings
  // ================================================================

  // Enables or disables GitHub Copilot globally.
  // Options:
  //   true  → Copilot is enabled.
  //   false → Copilot is disabled.
  "github.copilot.enable": {
    "markdown": true,
    "plaintext": true,
    "scminput": true
  },

  // ================================================================
  // 🔧 Custom CSS/JS Injection (Optional)
  // ================================================================

  // If you use the Custom CSS and JS extension, specify the paths to your custom files.
  // Make sure these files exist and that the extension is enabled.
  "vscode_custom_css.imports": [
    "file:///home/mrzero/Documents/VSCODE/custom-vscode.css",
    "file:///home/mrzero/Documents/VSCODE/vscode-script.js"
  ],

  // ================================================================
  // 🎨 Custom Workbench Colors
  // ================================================================

  // Customize specific UI colors.
  // Here, the active tab border is made transparent.
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#0000"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "explorer.confirmDelete": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.colorTheme": "Tokyo Night",
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "chat.commandCenter.enabled": false,
  "window.commandCenter": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.ignoreRebaseWarning": true
}
